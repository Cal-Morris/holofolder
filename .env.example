# Copy to .env.local and fill in. Only the Supabase values are needed for `bun run dev`.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes, the share page and the price refresh.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL (optional) ---
# Base URL for auth email redirects. Falls back to the Vercel URLs, then localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Card database sync (optional) ---
# Direct (non-pooling) Postgres URL for `bun run sync-card-db` and /api/admin/sync-card-db.
# DATABASE_URL is used when this is unset.
POSTGRES_URL_NON_POOLING=
# Bearer secret for /api/admin/* routes. Any one of these works; CRON_SECRET also guards the price-refresh cron.
CARD_DB_SYNC_SECRET=
SYNC_SECRET=
CRON_SECRET=
# Local checkout of the TCGdex cards-database repo for the CLI sync (optional).
BINDERDEX_TCG_REPO_DIR=

# --- Card images (optional) ---
# Mirror backend: r2 | blob | off (unset = legacy Blob behaviour). See docs/card-image-store.md.
CARD_IMAGE_STORE=
# Cloudflare R2 (when CARD_IMAGE_STORE=r2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Vercel Blob token. When set, card images are mirrored into Blob; set CARD_IMAGE_BLOB=0 to disable.
BLOB_READ_WRITE_TOKEN=
CARD_IMAGE_BLOB=

# --- Pricing (optional) ---
# PokePulse session for market data.
POKEPULSE_COOKIE=
POKEPULSE_CSRF_TOKEN=
# Workflow world for the price-refresh workflow when running outside Vercel (e.g. "postgres").
WORKFLOW_TARGET_WORLD=

# --- Testing (optional) ---
# Serves /e2e-harness. Set automatically by `bun run test:e2e`.
BINDERDEX_E2E=
# Use a locally installed Chrome for Playwright instead of the bundled Chromium.
CHROME_PATH=
