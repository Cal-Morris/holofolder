{
  "name": "holofolder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/verify-docs-css.mjs",
    "dev": "next dev",
    "lint": "eslint . --max-warnings=55",
    "sync-card-db": "bun scripts/sync-card-db.ts",
    "sync-card-prices": "bun scripts/sync-card-prices.ts",
    "sync-card-supplements": "bun scripts/sync-card-supplements.ts",
    "mirror-card-images": "bun scripts/mirror-card-images.ts",
    "start": "next start",
    "test": "bun test tests/",
    "test:api:smoke": "bun scripts/api-smoke.ts",
    "test:coverage": "bun test tests/ --coverage",
    "test:e2e": "playwright test",
    "test:e2e:matrix": "playwright test --project='*'",
    "test:e2e:smoke": "playwright test --grep @smoke --max-failures=1",
    "analyze:first-load": "node scripts/first-load-js.mjs .next",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "next typegen && tsrs --noEmit",
    "typecheck:tsc": "next typegen && tsc --noEmit",
    "scan:secrets": "gitleaks git --log-opts=--all --redact --ignore-gitleaks-allow --no-banner"
  },
