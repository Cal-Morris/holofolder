{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Next.js, Playwright, Bun and the other plugins add their own entries (app routes, proxy.ts, configs).
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.test.{ts,tsx}",
    "e2e/**/*.e2e.ts",
    "workflows/*.ts",
    "playwright.*.config.ts",
  ],
  // public/ is static (sw.js is plain script), and the workflow registrations are generated by the build.
  "project": ["**/*.{ts,tsx,mjs,js,mdx,css}", "!public/**", "!app/.well-known/workflow/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // Loaded by name at runtime through WORKFLOW_TARGET_WORLD and traced in next.config.mjs, never imported.
    "@workflow/world-postgres",
    // Next.js resolves `import 'server-only'` itself; it is not an npm dependency of this app.
    "server-only",
    // Only a JSDoc type reference in postcss.config.mjs.
    "postcss-load-config",
  ],
  // System tools: gitleaks for `scan:secrets`, psql for the opt-in local SQL tests.
  "ignoreBinaries": ["gitleaks", "psql"],
}
