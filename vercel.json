{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/app/api/card-prices/refresh",
      "schedule": "0 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/workflow/:path*",
      "destination": "/app/.well-known/workflow/:path*"
    },
    {
      "source": "/app/_vercel/:path*",
      "destination": "https://app.holofolder.com/_vercel/:path*"
    }
  ]
}
